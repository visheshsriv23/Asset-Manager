{
  "name": "@symbtech/shipyard",
  "version": "0.1.9",
  "description": "Reusable agent skills and prompt assets for Codex and Claude Code.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "bin": {
    "shipyard": "scripts/setup-project.mjs"
  },
  "files": [
    "skills/",
    "prompt-library/",
    "setup/",
    "scripts/",
    "README.md"
  ],
  "scripts": {
    "build:lib": "node scripts/build-lib.mjs",
    "prepack": "npm run build:lib",
    "postinstall": "node scripts/setup-project.mjs"
  },
  "keywords": [
    "agent",
    "skills",
    "codex",
    "claude-code"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@bitbucket.org/symbtech/ai-skills.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18"
  }
}
